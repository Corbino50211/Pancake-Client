<Window x:Class="Pancake.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Pancake Client" Width="1260" Height="850" MinWidth="1000" MinHeight="700" Icon="Assets/pancake-logo.png" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#18211A" Padding="18,25">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="8,0,0,24">
          <Border Width="68" Height="68" HorizontalAlignment="Left" CornerRadius="12" Background="White" Margin="0,0,0,16"><Image Source="Assets/pancake-logo.png" Margin="3"/></Border>
          <TextBlock Text="PANCAKE" FontSize="23" FontWeight="Bold"/><TextBlock Text="CLIENT  /  PCVR" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="8,20,0,0"><TextBlock Text="v0.1 · Desktop alpha" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="BridgeBadge" Text="Companion offline" Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}" FontSize="12"/></StackPanel>
        <ListBox x:Name="Navigation" SelectionChanged="Navigation_SelectionChanged" SelectedIndex="0">
          <ListBoxItem Content="Home"/><ListBoxItem Content="Browse Mods"/><ListBoxItem Content="Installed Mods"/><ListBoxItem Content="Profiles &amp; Packs"/><ListBoxItem Content="Avatars &amp; BodyLog"/><ListBoxItem Content="Levels &amp; Saves"/><ListBoxItem Content="Camera &amp; OBS"/><ListBoxItem Content="Console"/><ListBoxItem Content="Settings"/>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="32,26,32,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,22"><TextBlock DockPanel.Dock="Right" Text="BONELAB MOD WORKSPACE" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/><TextBlock x:Name="ProfileBadge" Text="Current setup" FontWeight="SemiBold"/></DockPanel>
      <Grid x:Name="Pages" Grid.Row="1">
        <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="Your sandbox. Your stack." Style="{StaticResource Heading}"/><TextBlock Text="Mods, camera tools, and recording controls in one place." Style="{StaticResource Muted}"/>
          <Border Style="{StaticResource Card}" Background="#293D2D"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Ready for another run?" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="GameStatus" Text="Choose your BONELAB folder in Settings to get started." Style="{StaticResource Muted}"/><WrapPanel><Button Content="Launch BONELAB" Style="{StaticResource PrimaryButton}" Click="Launch_Click"/><Button Content="Set up game" Click="Setup_Click"/></WrapPanel></StackPanel><Image Grid.Column="1" Source="Assets/pancake-logo.png" Width="128" Height="128" Margin="12"/></Grid></Border>
          <UniformGrid Columns="3"><Border Style="{StaticResource Card}" Margin="0,0,12,16"><StackPanel><TextBlock x:Name="ModCount" Text="0" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="installed mods" Style="{StaticResource Muted}"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,16"><StackPanel><TextBlock x:Name="EnabledCount" Text="0" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="enabled" Style="{StaticResource Muted}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="ObsHomeStatus" Text="Offline" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="OBS connection" Style="{StaticResource Muted}"/></StackPanel></Border></UniformGrid>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Get started" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="1. Select BONELAB and its content Mods folder in Settings.&#10;2. Review installed mods or browse Thunderstore.&#10;3. Connect OBS under Camera &amp; OBS.&#10;4. Build and install the companion for in-game controls." Style="{StaticResource Muted}"/><Button Content="Open setup guide" HorizontalAlignment="Left" Click="Guide_Click"/></StackPanel></Border>
          <TextBlock Text="This first release includes local mod management and OBS controls. Automatic code-mod dependency installation, mod.io login, avatar editing, and level loading are tracked for later builds." Style="{StaticResource Muted}"/>
        </StackPanel></ScrollViewer>
        <Grid x:Name="BrowsePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Find your next mod" Style="{StaticResource Heading}"/><TextBlock Text="Live Thunderstore catalog. Downloads are ZIPs; follow each author's dependencies and game-patch requirements." Style="{StaticResource Muted}"/></StackPanel>
          <DockPanel Grid.Row="1"><Button DockPanel.Dock="Right" Content="Refresh catalog" Click="Catalog_Click"/><TextBox x:Name="CatalogSearch" TextChanged="CatalogSearch_TextChanged" ToolTip="Search names, authors, and descriptions" Margin="0,0,12,12"/></DockPanel>
          <DataGrid x:Name="CatalogGrid" Grid.Row="2" SelectionChanged="CatalogGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="MOD" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="AUTHOR" Binding="{Binding Author}" Width="150"/><DataGridTextColumn Header="VERSION" Binding="{Binding Version}" Width="95"/></DataGrid.Columns></DataGrid>
          <StackPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="CatalogDescription" Text="Select a mod to see its description and dependencies." Style="{StaticResource Muted}" MaxHeight="100"/><WrapPanel><Button Content="Download selected ZIP" Style="{StaticResource PrimaryButton}" Click="Download_Click"/><Button Content="Mod page" Click="ModPage_Click"/><Button Content="Open mod.io" Click="Modio_Click"/></WrapPanel></StackPanel>
        </Grid>
        <Grid x:Name="ModsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Your mod stack" Style="{StaticResource Heading}"/><TextBlock Text="Code mods, plugins, and content. Close BONELAB before making changes. Disabling a code mod does not disable its dependencies." Style="{StaticResource Muted}"/></StackPanel>
          <DockPanel Grid.Row="1"><Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click"/><TextBox x:Name="ModSearch" TextChanged="ModSearch_TextChanged" ToolTip="Search installed mods" Margin="0,0,12,12"/></DockPanel>
          <DataGrid x:Name="ModsGrid" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn Header="MOD" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="120"/><DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="110"/></DataGrid.Columns></DataGrid>
          <WrapPanel Grid.Row="3" Margin="0,16,0,0"><Button Content="Enable / disable" Style="{StaticResource PrimaryButton}" Click="ToggleMod_Click"/><Button Content="Open folder" Click="OpenMod_Click"/><Button Content="Import content ZIP" Click="ImportContent_Click"/></WrapPanel>
        </Grid>
        <ScrollViewer x:Name="ProfilesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="Keep your setups organized" Style="{StaticResource Heading}"/><TextBlock Text="Profiles remember which installed mods are enabled. They do not download missing mods or replace versions in this release." Style="{StaticResource Muted}"/>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Save current setup" FontSize="19" FontWeight="SemiBold"/><TextBox x:Name="ProfileName" Text="My sandbox"/><Button Content="Save new profile" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Click="SaveProfile_Click"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Saved profiles" FontSize="19" FontWeight="SemiBold"/><ComboBox x:Name="ProfilesList" DisplayMemberPath="Name"/><WrapPanel><Button Content="Apply profile" Click="ApplyProfile_Click"/><Button Content="Export JSON" Click="ExportProfile_Click"/><Button Content="Import JSON" Click="ImportProfile_Click"/></WrapPanel><TextBlock Text="Applying a profile leaves newly installed mods that are absent from the profile unchanged. Your current setup is backed up before each apply." Style="{StaticResource Muted}"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
        <ScrollViewer x:Name="AvatarsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Avatars &amp; BodyLog" Style="{StaticResource Heading}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Planned for the next companion update" FontSize="20"/><TextBlock Text="Installed avatar discovery, favorites, BodyLog slots, and 3D previews need the live game warehouse. This first companion focuses on camera and OBS controls." Style="{StaticResource Muted}"/><Button Content="Browse avatar mods on mod.io" HorizontalAlignment="Left" Click="Modio_Click"/></StackPanel></Border></StackPanel></ScrollViewer>
        <ScrollViewer x:Name="LevelsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Levels &amp; Saves" Style="{StaticResource Heading}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Back up a save folder" FontSize="20"/><TextBlock Text="Choose your BONELAB save folder and create a timestamped ZIP. The original files stay in place. Close the game before backing up." Style="{StaticResource Muted}"/><Button Content="Create save backup…" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Click="Backup_Click"/></StackPanel></Border><TextBlock Text="In-game level selection and progression tools are planned. Backups can be extracted manually while BONELAB is closed." Style="{StaticResource Muted}"/></StackPanel></ScrollViewer>
        <ScrollViewer x:Name="CameraPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="Camera &amp; OBS" Style="{StaticResource Heading}"/><TextBlock Text="Frame your sandbox. Control recording from your desktop or the in-game Pancake BoneMenu." Style="{StaticResource Muted}"/>
          <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="EXPERIMENTAL · COMPANION REQUIRED" FontSize="10" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Game camera" FontSize="20" FontWeight="SemiBold"/></DockPanel><TextBlock Text="The first capture feed is 640 × 360 at up to 10 FPS. For full-quality headset footage, capture BONELAB's normal mirror directly in OBS." Style="{StaticResource Muted}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="View"/><ComboBox x:Name="CameraMode"><ComboBoxItem Content="First person"/><ComboBoxItem Content="Right hand"/><ComboBoxItem Content="Stationary"/><ComboBoxItem Content="Follow"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock x:Name="FovLabel" Text="Field of view · 70°"/><Slider x:Name="FovSlider" Minimum="30" Maximum="110" Value="70" ValueChanged="Fov_ValueChanged" Margin="0,12"/></StackPanel></Grid>
            <WrapPanel><Button Content="Start / update camera" Click="CameraStart_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Stop camera" Click="CameraStop_Click"/><Button Content="Open capture window" Click="CaptureWindow_Click"/><Button Content="Save screenshot" Click="Screenshot_Click"/></WrapPanel><TextBlock x:Name="CameraStatus" Text="No camera feed. Start BONELAB with the companion installed." Style="{StaticResource Muted}"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="OBS Studio" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="In OBS: Tools → WebSocket Server Settings → Enable WebSocket server. Enter its address and password below. Passwords are kept in memory only." Style="{StaticResource Muted}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Local WebSocket address"/><TextBox x:Name="ObsAddress"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="WebSocket password"/><PasswordBox x:Name="ObsPassword"/></StackPanel></Grid>
            <WrapPanel><Button Content="Connect OBS" Style="{StaticResource PrimaryButton}" Click="ConnectObs_Click"/><Button Content="Disconnect" Click="DisconnectObs_Click"/><Button Content="Refresh scenes" Click="ObsScenes_Click"/></WrapPanel><TextBlock x:Name="ObsStatus" Text="OBS disconnected" Style="{StaticResource Muted}"/>
            <TextBlock Text="Program scene"/><ComboBox x:Name="ObsScenes"/><Button Content="Switch to selected scene" HorizontalAlignment="Left" Click="SwitchScene_Click"/>
            <WrapPanel><Button Content="Start recording" Click="StartRecording_Click"/><Button Content="Stop recording" Click="StopRecording_Click"/><Button Content="Start streaming" Click="StartStreaming_Click"/><Button Content="Stop streaming" Click="StopStreaming_Click"/></WrapPanel>
            <TextBlock Text="Microphone / audio source name in OBS"/><TextBox x:Name="MicSource"/><WrapPanel><Button Content="Mute microphone" Click="Mute_Click"/><Button Content="Unmute microphone" Click="Unmute_Click"/></WrapPanel>
            <CheckBox x:Name="AllowStreaming" Content="Allow in-game start/stop streaming controls" Checked="ObsPreferences_Changed" Unchecked="ObsPreferences_Changed"/>
            <TextBlock Text="In VR: BoneMenu → Pancake Client → OBS. Recording controls use the same OBS connection. Starting a stream from the desktop asks for confirmation." Style="{StaticResource Muted}"/>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
        <Grid x:Name="ConsolePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Live console" Style="{StaticResource Heading}"/><TextBlock Text="Reads MelonLoader/Latest.log from the selected game installation." Style="{StaticResource Muted}"/></StackPanel><TextBox Grid.Row="1" x:Name="LogFilter" ToolTip="Filter log lines (for example: error)" TextChanged="LogFilter_TextChanged"/><TextBox x:Name="LogText" Grid.Row="2" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/><WrapPanel Grid.Row="3"><Button Content="Export visible log" Click="ExportLog_Click"/><Button Content="Open log folder" Click="OpenLogs_Click"/></WrapPanel></Grid>
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="Make it yours" Style="{StaticResource Heading}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="BONELAB installation" FontSize="20"/><TextBlock Text="Select the BONELAB game folder containing BONELAB_Steam_Windows64.exe or BONELAB.exe. Steam detection checks all registered Steam libraries. Meta PC installs can be selected manually." Style="{StaticResource Muted}"/><TextBox x:Name="GamePath"/><WrapPanel><Button Content="Browse game folder…" Click="BrowseGame_Click"/><Button Content="Detect Steam install" Click="Detect_Click"/></WrapPanel>
          <TextBlock Text="Content Mods folder" Margin="0,12,0,0"/><TextBlock Text="Separate from the code Mods folder in the game installation." Style="{StaticResource Muted}"/><TextBox x:Name="ContentPath"/><Button Content="Browse content folder…" HorizontalAlignment="Left" Click="BrowseContent_Click"/>
          <TextBlock Text="Screenshot folder" Margin="0,12,0,0"/><TextBox x:Name="ScreenshotPath"/><Button Content="Save settings" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="In-game companion" FontSize="20"/><TextBlock Text="Requires a compatible MelonLoader and BoneLib installation. Build the companion against your game's generated assemblies using scripts/Build-Companion.ps1, then install its DLL below while BONELAB is closed." Style="{StaticResource Muted}"/><WrapPanel><Button Content="Install companion DLL…" Click="InstallCompanion_Click"/><Button Content="Open setup guide" Click="Guide_Click"/></WrapPanel><TextBlock x:Name="LoaderStatus" Style="{StaticResource Muted}"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </Grid>
      <Border Grid.Row="2" BorderBrush="#354637" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0"><TextBlock x:Name="StatusText" Text="Welcome to Pancake Client." Foreground="{StaticResource MutedBrush}" FontSize="12" MaxHeight="55"/></Border>
    </Grid>
  </Grid>
</Window>
